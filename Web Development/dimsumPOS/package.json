{
  "name": "dimsum-pos",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev -H 0.0.0.0 -p 3000",
    "dev:coding": "next dev -H 0.0.0.0 -p 3001",
    "build": "next build",
    "start": "next start -H 0.0.0.0 -p 3000",
    "prod:up": "pm2 start ecosystem.config.js",
    "prod:down": "pm2 stop pos-dimsum",
    "prod:log": "pm2 logs pos-dimsum",
    "prod:status": "pm2 status",
    "prod:redeploy": "npm run build && npx pm2 restart pos-dimsum",
    "typecheck": "tsc --noEmit",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:seed:kosong": "tsx scripts/seed-kosong.ts",
    "db:reset": "tsx scripts/reset.ts",
    "db:reset:kosong": "tsx scripts/reset-kosong.ts",
    "test": "tsx --test tests/money.test.ts tests/alur.test.ts tests/kemasan-bertingkat.test.ts",
    "test:http": "tsx --test tests/otorisasi.test.ts"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "jose": "^6.1.0",
    "next": "^15.5.4",
    "pg": "^8.16.3",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.13",
    "@types/node": "^24.5.2",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "dotenv": "^17.2.2",
    "pm2": "^7.0.4",
    "pm2-windows-startup": "^1.0.3",
    "tailwindcss": "^4.1.13",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
